[Unit]
Description=Wan2.2 Video Generation API Server (14B-GGUF)
Documentation=https://github.com/sinke237/music
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/opt/app/music/Wan2.2

# GPU Configuration - Single GPU (shared with ACE-Step)
Environment="CUDA_VISIBLE_DEVICES=0"
Environment="PYTHONUNBUFFERED=1"
Environment="PYTHONDONTWRITEBYTECODE=1"

# Model: Wan2.2-14B-T2V-GGUF (Q6_K variant)
# Uses ComfyUI for efficient inference on 24GB VRAM
ExecStart=/opt/app/music/Wan2.2/.venv/bin/python api_server.py --host 127.0.0.1 --port 8080 --model gguf-q6 --default-size 1280x720

Restart=on-failure
RestartSec=30
TimeoutStartSec=1200
TimeoutStopSec=300

StandardOutput=append:/opt/logs/wan22.log
StandardError=append:/opt/logs/wan22-error.log

# Resource Limits (for A10G 24GB)
MemoryHigh=20G
MemoryMax=24G

CPUWeight=90
IOWeight=90

Nice=-5

[Install]
WantedBy=multi-user.target